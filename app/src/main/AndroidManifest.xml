<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Runs on phones and Android TV (D-pad). Neither feature is required, so the app
         installs on both; a touchscreen is explicitly optional for TV devices. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Packages we check for install/update state (Android 11+ visibility) -->
    <queries>
        <package android:name="app.revanced.android.youtube" />
        <package android:name="app.revanced.android.apps.youtube.music" />
        <package android:name="app.morphe.android.youtube" />
        <package android:name="app.morphe.android.apps.youtube.music" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.twitter.android" />
        <package android:name="app.revanced.android.gms" />
        <!-- NewTube (phone) -->
        <package android:name="io.github.aleixrodriala.arc" />
        <!-- Android TV apps shown in the TV tab -->
        <package android:name="org.smarttube.stable" />
        <package android:name="app.smarttube" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <!-- Resolve the Telegram app (tg://) so we can open it directly when installed -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
    </queries>

    <application
        android:name=".VmproApp"
        android:allowBackup="true"
        android:banner="@drawable/ic_vmpro_logo"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VMPro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VMPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Also surface the app on the Android TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".util.UninstallReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
